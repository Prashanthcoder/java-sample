import java.util.*;
class Sample
{
public static void main(String[] args){
	int[] t1 = {1, 3, 5};
int[] t2 = {2, 4, 6};

int[] temp = new int[t1.length+t2.length];
System.arraycopy(t1, 0, temp, 0, t1.length);
System.arraycopy(t2, 0, temp, t1.length, t2.length);
Arrays.sort(temp);
for(int i=0;i<temp.length;i++){
	System.out.println(temp[i]+" ");
}
}
}